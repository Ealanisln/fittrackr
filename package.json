{
  "name": "fittrackr",
  "version": "0.1.0",
  "private": true,
  "description": "FitTrackr - AI-powered fitness tracking platform",
  "scripts": {
    "dev": "pnpm --filter @fittrack/web dev & pnpm --filter @fittrack/api dev",
    "dev:web": "pnpm --filter @fittrack/web dev",
    "dev:api": "pnpm --filter @fittrack/api dev",
    "build": "pnpm --filter @fittrack/web build && pnpm --filter @fittrack/api build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:api": "vitest --project=api",
    "test:web": "vitest --project=web",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "typecheck": "pnpm --filter @fittrack/api typecheck && pnpm --filter @fittrack/web typecheck",
    "db:push": "pnpm --filter @fittrack/database db:push",
    "db:migrate": "pnpm --filter @fittrack/database db:migrate",
    "db:studio": "pnpm --filter @fittrack/database db:studio",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "vitest-mock-extended": "^2.0.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
